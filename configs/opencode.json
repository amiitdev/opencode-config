{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "permission": "allow",
  "provider": {
    "opencode-free": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenCode Free",
      "options": {
        "baseURL": "http://localhost:20128/v1"
      },
      "models": {
        "oc/big-pickle": { "name": "big-pickle", "tool_call": true, "reasoning": true },
        "oc/deepseek-v4-flash-free": { "name": "deepseek-v4-flash-free", "tool_call": true, "reasoning": true },
        "oc/mimo-v2.5-free": { "name": "mimo-v2.5-free", "tool_call": true, "reasoning": true },
        "oc/hy3-free": { "name": "hy3-free", "tool_call": true, "reasoning": true },
        "oc/nemotron-3-ultra-free": { "name": "nemotron-3-ultra-free", "tool_call": true, "reasoning": true },
        "oc/north-mini-code-free": { "name": "north-mini-code-free", "tool_call": true, "reasoning": true }
      }
    },
    "omniroute": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OmniRoute (OpenRouter)",
      "options": {
        "baseURL": "http://localhost:20128/v1"
      },
      "models": {
        "auto/best-coding": { "name": "Auto Best Coding", "tool_call": true, "reasoning": true },
        "auto/best-fast": { "name": "Auto Best Fast", "tool_call": true, "reasoning": true },
        "auto/best-free": { "name": "Auto Best Free", "tool_call": true, "reasoning": true },
        "auto/best-reasoning": { "name": "Auto Best Reasoning", "tool_call": true, "reasoning": true },
        "auto/best-vision": { "name": "Auto Best Vision", "tool_call": true, "reasoning": true, "attachment": true },
        "auto/coding": { "name": "Auto Coding", "tool_call": true, "reasoning": true },
        "auto/fast": { "name": "Auto Fast", "tool_call": true, "reasoning": true },
        "auto/chat": { "name": "Auto Chat", "tool_call": true, "reasoning": true },
        "auto/cheap": { "name": "Auto Cheap", "tool_call": true, "reasoning": true },
        "auto/smart": { "name": "Auto Smart", "tool_call": true, "reasoning": true },
        "auto/pro-coding": { "name": "Auto Pro Coding", "tool_call": true, "reasoning": true },
        "auto/pro-reasoning": { "name": "Auto Pro Reasoning", "tool_call": true, "reasoning": true },
        "auto/claude-opus": { "name": "Claude Opus", "tool_call": true, "reasoning": true },
        "auto/claude-sonnet": { "name": "Claude Sonnet", "tool_call": true, "reasoning": true },
        "auto/offline": { "name": "Offline", "tool_call": true, "reasoning": true }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (Local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3.5": { "name": "qwen3.5" }
      }
    },
    "ollama-cloud": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Cloud",
      "options": {
        "baseURL": "https://ollama.com/v1",
        "headers": {
          "Authorization": "Bearer YOUR_KEY_HERE"
        }
      },
      "models": {
        "gpt-oss:120b": { "name": "gpt-oss:120b" },
        "gpt-oss:20b": { "name": "gpt-oss:20b" },
        "gemma4:31b": { "name": "gemma4:31b" },
        "minimax-m3": { "name": "minimax-m3" },
        "nemotron-3-nano:30b": { "name": "nemotron-3-nano:30b" },
        "nemotron-3-super": { "name": "nemotron-3-super" },
        "nemotron-3-ultra": { "name": "nemotron-3-ultra" }
      }
    }
  },
  "model": "omniroute/auto/best-coding",
  "small_model": "omniroute/auto/best-fast",
  "mcp": {
    "gmail": {
      "type": "local",
      "command": ["npx", "-y", "@gongrzhe/server-gmail-autoauth-mcp"],
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    }
  }
}
